# syntax=docker/dockerfile:1
#
# Migrations and seeding. Built from the REPOSITORY ROOT, not apps/cms, so it
# can carry the seed's artwork fixtures from mocks/img without duplicating them
# into the app directory. Never serves traffic — it runs as a Job and exits.
#
#   docker build -f apps/cms/Dockerfile.migrate -t phatbrew/cms-migrate:local .
FROM node:22-alpine
WORKDIR /app
RUN apk add --no-cache libc6-compat
COPY apps/cms/package.json apps/cms/package-lock.json* ./
RUN npm install --no-audit --no-fund
COPY apps/cms/ ./
# The seed resolves artwork at ../../../../mocks/img relative to src/seed,
# which from /app/src/seed lands at /mocks/img.
COPY mocks/img/ /mocks/img/
ENV NODE_ENV=production NEXT_TELEMETRY_DISABLED=1
CMD ["npm", "run", "migrate"]
