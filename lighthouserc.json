{
  "ci": {
    "collect": {
      "numberOfRuns": 3,
      "url": [
        "http://phatbrew.localhost:8080/",
        "http://phatbrew.localhost:8080/venues/west-perth",
        "http://phatbrew.localhost:8080/beers",
        "http://phatbrew.localhost:8080/whats-on"
      ]
    },
    "assert": {
      "assertions": {
        "categories:performance": ["error", { "minScore": 0.9 }],
        "categories:accessibility": ["error", { "minScore": 1 }],
        "categories:seo": ["error", { "minScore": 0.95 }],
        "cumulative-layout-shift": ["error", { "maxNumericValue": 0.1 }],
        "total-byte-weight": ["error", { "maxNumericValue": 1500000 }],
        "uses-responsive-images": ["warn", { "minScore": 0.9 }],
        "unsized-images": ["error", { "minScore": 1 }]
      }
    }
  }
}
